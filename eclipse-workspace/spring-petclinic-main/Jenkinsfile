
pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('Build with Maven') {
            steps {
                bat 'mvn -B clean package'
            }
        }

        stage('Verify Build') {
            steps {
                bat 'dir target'
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed. Check Console Output.'
        }
    }
}
